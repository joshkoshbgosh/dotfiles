{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "yolo": {
      "mode": "primary",
      "color": "#FF6B6B",
      "permission": {
        "bash": {
	    "git add *": "allow",
	    "git commit *": "allow",
	    "sleep *": "allow",
	    "graphify *": "allow",
	    "openspec *": "allow",
	    "echo *": "allow",
	    "curl *": "allow",
	    "jq *": "allow",
	    "sed *": "allow"
        },
        "grep": "allow",
        "glob": "allow",
        "write": "allow",
        "edit": "allow",
        "patch": "allow",
        "webfetch": "allow",
        "skill": "allow"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "ask",

      "pwd": "allow",
      "pwd *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "stat": "allow",
      "stat *": "allow",
      "file": "allow",
      "file *": "allow",
      "wc": "allow",
      "wc *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "grep": "allow",
      "grep *": "allow",

      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git remote -v": "allow",
      "git rev-parse --abbrev-ref HEAD": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",

      "bun run *": "allow",
      "bunx tsc --noEmit": "allow",
      "bun test *": "allow"
    },

    "edit": "ask",
    "webfetch": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "skill": "ask"
  },
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true,
      "oauth": {}
    },
  "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "Accept": "application/json",
        "X-Goog-Api-Key": "SET_LOCALLY"
      }
    },
    "emacs": {
      "type": "local",
      "command": ["npx", "-y", "@keegancsmith/emacs-mcp-server"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    }
  },
  "plugin": [
    "opencode-mobile@latest"
  ]
}
