(ert-deftest my/org-gcal-package-configuration-is-cached-for-polling ()
  (let ((my/org-gcal-configured-p nil)
        (configured 0)
        (reloaded 0))
    (cl-letf (((symbol-function 'my/org-gcal-configure)
               (lambda () (cl-incf configured)))
              ((symbol-function 'require) #'ignore)
              ((symbol-function 'org-gcal-reload-client-id-secret)
               (lambda () (cl-incf reloaded))))
