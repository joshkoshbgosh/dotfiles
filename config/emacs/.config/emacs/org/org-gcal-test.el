    (cl-letf (((symbol-function 'my/org-gcal--prepare-package)
               (lambda () (setq prepared t)))
              ((symbol-function 'org-gcal-fetch)
               (lambda () (setq fetched t))))
      (should (eq (my/org-gcal-fetch) :already-running))
      (should-not prepared)
      (should-not fetched))))

(ert-deftest my/org-gcal-success-saves-and-invalidates-changed-calendar ()
  (let* ((file (make-temp-file "lifeos-gcal-" nil ".org" "* Event\n"))
         (my/org-gcal-calendar-file file)
         (my/org-gcal-fetch-in-progress nil)
         success-callback watch-callback (invalidations 0))
    (unwind-protect
        (cl-letf (((symbol-function 'my/org-gcal--prepare-package) #'ignore)
                  ((symbol-function 'org-gcal-fetch)
                   (lambda ()
                     (with-current-buffer (find-file-noselect file)
                       (goto-char (point-max))
                       (insert "Changed\n"))
                     'fetch))
                  ((symbol-function 'deferred:nextc)
                   (lambda (_ callback)
                     (setq success-callback callback)
                     'success))
                  ((symbol-function 'deferred:watch)
                   (lambda (_ callback)
                     (setq watch-callback callback)
                     'watched))
                  ((symbol-function 'my/org-gcal-normalize-calendar-buffer)
                   (lambda () nil))
                  ((symbol-function 'my/lifeos-invalidate-project-analysis)
                   (lambda (&rest _) (cl-incf invalidations))))
          (should (eq (my/org-gcal-fetch) 'watched))
          (should my/org-gcal-fetch-in-progress)
          (should (eq (funcall success-callback 'result) 'result))
          (should (= invalidations 1))
          (funcall watch-callback nil)
          (should-not my/org-gcal-fetch-in-progress)
          (with-current-buffer (find-file-noselect file)
            (should-not (buffer-modified-p))))
      (when-let* ((buffer (get-file-buffer file)))
        (set-buffer-modified-p nil)
        (kill-buffer buffer))
      (when (file-exists-p (concat file ".sync-receipt.json"))
        (delete-file (concat file ".sync-receipt.json")))
      (delete-file file))))

