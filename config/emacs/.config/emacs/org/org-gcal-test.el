(ert-deftest my/org-gcal-receipt-is-persisted-from-saved-bytes-only ()
  (let* ((file (make-temp-file "lifeos-receipt-" nil ".org" "* Event\n"))
         (my/org-gcal-calendar-file file)
         (org-gcal-down-days 2)
         (fetched-at (date-to-time "2026-11-08T10:00:00Z")))
    (unwind-protect
        (progn
          (my/org-gcal--record-successful-fetch fetched-at)
          (let* ((json-object-type 'plist)
                 (receipt (json-read-file (concat file ".sync-receipt.json"))))
            (should (= (plist-get receipt :version) 2))
            (should (equal (plist-get receipt :availability) "unverified"))
            (should (equal (plist-get receipt :sha256)
                           (with-temp-buffer
                             (insert-file-contents-literally file)
                             (secure-hash 'sha256 (current-buffer)))))
            (should (equal (plist-get receipt :fetchedAt)
                           "2026-11-08T10:00:00Z"))
            (should (equal (plist-get receipt :requestedEnd)
                           "2026-11-10T10:00:00Z"))
            (should-not (plist-get receipt :coverageEnd))))
      (delete-file file)
      (when (file-exists-p (concat file ".sync-receipt.json"))
        (delete-file (concat file ".sync-receipt.json"))))))

(ert-deftest my/org-gcal-failed-save-does-not-replace-success-receipt ()
  (let* ((file (make-temp-file "lifeos-receipt-failure-" nil ".org" "* Event\n"))
         (my/org-gcal-calendar-file file)
         (fetched-at (date-to-time "2026-11-08T10:00:00Z")))
    (unwind-protect
        (progn
          (my/org-gcal--record-successful-fetch fetched-at)
          (let ((previous (with-temp-buffer
                            (insert-file-contents (concat file ".sync-receipt.json"))
                            (buffer-string))))
            (with-current-buffer (find-file-noselect file)
              (goto-char (point-max))
              (insert "Unsaved change\n"))
            (should-error (my/org-gcal--record-successful-fetch
                           (date-to-time "2026-11-08T11:00:00Z")))
            (should (equal previous
                           (with-temp-buffer
                             (insert-file-contents (concat file ".sync-receipt.json"))
                             (buffer-string))))))
      (when-let* ((buffer (get-file-buffer file)))
        (set-buffer-modified-p nil)
        (kill-buffer buffer))
      (delete-file file)
      (delete-file (concat file ".sync-receipt.json")))))

(ert-deftest my/org-gcal-trusted-refresh-writes-trusted-v3-receipt ()
  (let* ((file (make-temp-file "lifeos-trusted-gcal-" nil ".org" "* Event\n"))
         (my/org-gcal-calendar-file file)
         (org-gcal-fetch-file-alist (list (cons "cal-1" file)))
         (org-gcal-up-days 7)
         (org-gcal-down-days 60)
         (org-gcal--sync-lock nil)
         (my/org-gcal-fetch-in-progress nil)
         (my/org-gcal--trusted-fetch-active nil)
         (my/org-gcal--trusted-fetch-errors nil)
         (my/org-gcal--trusted-requested-start nil)
         (my/org-gcal--trusted-requested-end nil)
         (my/org-gcal-last-successful-fetch-time nil)
         (my/org-gcal-calendar-coverage-end nil)
         (now (date-to-time "2026-11-08T10:00:00Z"))
         success-callback watch-callback)
    (unwind-protect
        (cl-letf (((symbol-function 'current-time) (lambda () now))
                  ((symbol-function 'my/org-gcal--prepare-package) #'ignore)
                  ((symbol-function 'org-gcal-sync-tokens-clear) #'ignore)
                  ((symbol-function 'org-gcal-fetch) (lambda () 'fetch))
                  ((symbol-function 'deferred:nextc)
                   (lambda (_ callback) (setq success-callback callback) 'success))
                  ((symbol-function 'deferred:watch)
                   (lambda (_ callback) (setq watch-callback callback) 'watched))
                  ((symbol-function 'my/org-gcal-normalize-calendar-buffer) #'ignore))
          (should (eq (my/org-gcal-trusted-refresh) 'watched))
          (should my/org-gcal--trusted-fetch-active)
          (should (eq (funcall success-callback 'result) 'result))
          (funcall watch-callback nil)
          (should-not my/org-gcal--trusted-fetch-active)
          (should-not my/org-gcal--trusted-fetch-errors)
          (let* ((json-object-type 'plist)
                 (receipt (json-read-file (concat file ".sync-receipt.json"))))
            (should (= (plist-get receipt :version) 3))
            (should (equal (plist-get receipt :availability) "trusted"))
            (should (equal (plist-get receipt :producer) "lifeos-org-gcal"))
            (should (equal (plist-get receipt :mode) "full"))
            (should (equal (plist-get receipt :pagination) "complete"))
            (should (equal (plist-get receipt :recurrence) "complete"))
            (should (equal (append (plist-get receipt :calendars) nil) '("cal-1")))
            (should (= (plist-get receipt :chunksRetrieved) 1))
            (should (equal (plist-get receipt :errors) []))
            (should (equal (plist-get receipt :fetchedAt) "2026-11-08T10:00:00Z"))
            (should (equal (plist-get receipt :expiresAt) "2026-11-08T10:30:00Z"))
            (should (equal (plist-get receipt :requestedStart) "2026-11-01T10:00:00Z"))
            (should (equal (plist-get receipt :requestedEnd) "2027-01-07T10:00:00Z"))
            (should (equal (plist-get receipt :sha256)
                           (with-temp-buffer
                             (insert-file-contents-literally file)
                             (secure-hash 'sha256 (current-buffer)))))
            (should (equal my/org-gcal-calendar-coverage-end
                           "2027-01-07T10:00:00Z"))))
      (when-let* ((buffer (get-file-buffer file)))
        (set-buffer-modified-p nil)
        (kill-buffer buffer))
      (when (file-exists-p (concat file ".sync-receipt.json"))
        (delete-file (concat file ".sync-receipt.json")))
      (delete-file file))))

(ert-deftest my/org-gcal-trusted-refresh-downgrades-on-swallowed-entry-error ()
  (let* ((file (make-temp-file "lifeos-trusted-gcal-error-" nil ".org" "* Event\n"))
         (my/org-gcal-calendar-file file)
         (org-gcal-fetch-file-alist (list (cons "cal-1" file)))
         (org-gcal-up-days 7)
         (org-gcal-down-days 60)
         (org-gcal--sync-lock nil)
         (my/org-gcal-fetch-in-progress nil)
         (my/org-gcal--trusted-fetch-active nil)
         (my/org-gcal--trusted-fetch-errors nil)
         (my/org-gcal--trusted-requested-start nil)
         (my/org-gcal--trusted-requested-end nil)
         (my/org-gcal-last-successful-fetch-time nil)
         (my/org-gcal-calendar-coverage-end nil)
         (now (date-to-time "2026-11-08T10:00:00Z"))
         success-callback watch-callback)
    (unwind-protect
        (cl-letf (((symbol-function 'current-time) (lambda () now))
                  ((symbol-function 'my/org-gcal--prepare-package) #'ignore)
                  ((symbol-function 'org-gcal-sync-tokens-clear) #'ignore)
                  ((symbol-function 'org-gcal-fetch)
                   (lambda ()
                     (message "org-gcal-sync: error: %s" "entry update failed")
                     'fetch))
                  ((symbol-function 'deferred:nextc)
                   (lambda (_ callback) (setq success-callback callback) 'success))
                  ((symbol-function 'deferred:watch)
                   (lambda (_ callback) (setq watch-callback callback) 'watched))
                  ((symbol-function 'my/org-gcal-normalize-calendar-buffer) #'ignore))
          (should (eq (my/org-gcal-trusted-refresh) 'watched))
          (should (equal my/org-gcal--trusted-fetch-errors
                         '("org-gcal-sync: error: entry update failed")))
          (funcall success-callback 'result)
          (funcall watch-callback nil)
          (let* ((json-object-type 'plist)
                 (receipt (json-read-file (concat file ".sync-receipt.json"))))
            (should (= (plist-get receipt :version) 2))
            (should (equal (plist-get receipt :availability) "unverified"))
            (should-not (plist-get receipt :calendars))
            (should-not (plist-get receipt :expiresAt))
            (should-not my/org-gcal-calendar-coverage-end)))
      (when-let* ((buffer (get-file-buffer file)))
        (set-buffer-modified-p nil)
        (kill-buffer buffer))
      (when (file-exists-p (concat file ".sync-receipt.json"))
        (delete-file (concat file ".sync-receipt.json")))
      (delete-file file))))

(ert-deftest my/org-gcal-trusted-refresh-timer-is-idempotent ()
  (let ((my/org-gcal-trusted-refresh-timer 'old)
        (my/org-gcal-trusted-refresh-interval 1200)
        cancelled scheduled)
    (cl-letf (((symbol-function 'timerp) (lambda (_) t))
              ((symbol-function 'cancel-timer)
               (lambda (timer) (push timer cancelled)))
              ((symbol-function 'run-at-time)
               (lambda (delay repeat function)
                 (setq scheduled (list delay repeat function))
                 'new)))
      (my/org-gcal-start-trusted-refresh)
      (should (equal cancelled '(old)))
      (should (equal scheduled '(60 1200 my/org-gcal--trusted-poll)))
      (should (eq my/org-gcal-trusted-refresh-timer 'new))
      (my/org-gcal-stop-trusted-refresh)
      (should-not my/org-gcal-trusted-refresh-timer))))

