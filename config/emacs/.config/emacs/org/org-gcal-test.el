(ert-deftest my/org-gcal-full-refresh-clears-before-fetch ()
  (let ((my/org-gcal-fetch-in-progress nil) calls)
    (cl-letf (((symbol-function 'my/org-gcal--prepare-package)
               (lambda () (push 'prepare calls)))
              ((symbol-function 'org-gcal-sync-tokens-clear)
               (lambda () (push 'clear calls)))
              ((symbol-function 'my/org-gcal-fetch)
               (lambda () (push 'fetch calls) 'deferred)))
      (should (eq (my/org-gcal-full-refresh) 'deferred))
      (should (equal (nreverse calls) '(prepare clear fetch))))))

