(ert-deftest my/org-gcal-normalization-maintains-roles-and-is-idempotent ()
  (let* ((file (make-temp-file "lifeos-gcal-roles-" nil ".org"))
         (my/org-gcal-calendar-file file)
         (my/org-gcal-calendar-role-alist
          '(("main-id")
            ("school-id" . "school")
            ("work-id" . "work"))))
    (unwind-protect
        (progn
          (with-temp-file file
            (insert "* Timed class\n:PROPERTIES:\n:calendar-id: school-id\n:END:\n<2026-10-15 Thu 09:00-10:00>\n"
                    "* All-day work event\n:PROPERTIES:\n:calendar-id: work-id\n:CALENDAR_ROLE: school\n:END:\n<2026-10-16 Fri>\n"
                    "* Main event\n:PROPERTIES:\n:calendar-id: main-id\n:CALENDAR_ROLE: personal\n:END:\n<2026-10-17 Sat 12:00-13:00>\n"))
          (should (my/org-gcal-normalize-calendar-buffer))
          (with-current-buffer (find-file-noselect file)
            (goto-char (point-min))
            (should (equal (org-entry-get nil "CALENDAR_ROLE") "school"))
            (should (equal (org-entry-get nil "GCAL_ALL_DAY") "no"))
            (outline-next-heading)
            (should (equal (org-entry-get nil "CALENDAR_ROLE") "work"))
            (should (equal (org-entry-get nil "GCAL_ALL_DAY") "yes"))
            (outline-next-heading)
            (should-not (org-entry-get nil "CALENDAR_ROLE")))
          (should-not (my/org-gcal-normalize-calendar-buffer)))
      (when-let* ((buffer (get-file-buffer file)))
        (set-buffer-modified-p nil)
        (kill-buffer buffer))
      (when (file-exists-p (concat file ".sync-receipt.json"))
        (delete-file (concat file ".sync-receipt.json")))
      (delete-file file))))

(ert-deftest my/org-gcal-polling-is-idempotent ()
  (let ((my/org-gcal-fetch-timer 'old)
        cancelled scheduled)
    (cl-letf (((symbol-function 'timerp) (lambda (_) t))
              ((symbol-function 'cancel-timer)
               (lambda (timer) (push timer cancelled)))
              ((symbol-function 'run-at-time)
               (lambda (delay repeat function)
                 (setq scheduled (list delay repeat function))
                 'new)))
      (my/org-gcal-start-polling)
      (should (equal cancelled '(old)))
      (should (equal scheduled '(900 900 my/org-gcal--poll)))
      (should (eq my/org-gcal-fetch-timer 'new)))))

