;;; org-gcal-test.el --- Tests for LifeOS calendar sync -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)

(defmacro use-package (&rest _args) nil)

(load (expand-file-name "org-gcal.el"
                        (file-name-directory
                         (or load-file-name buffer-file-name)))
      nil t)

(ert-deftest my/org-gcal-configure-maps-auth-categories-to-canonical-roles ()
  (let ((my/org-gcal-credentials-file "/missing")
        secrets)
    (setq secrets '(("client-id" . "id")
                    ("client-secret" . "secret")
                    ("main" . "main@example.com")
                    ("school" . "school@example.com")
                    ("work" . "work@example.com")
                    ("personal" . "personal@example.com")))
    (cl-letf (((symbol-function 'my/org-gcal--auth-secret)
               (lambda (_host user) (cdr (assoc user secrets)))))
      (should
       (equal (my/org-gcal-configure)
              '(("main@example.com")
                ("school@example.com" . "school")
                ("work@example.com" . "work")
                ("personal@example.com" . "personal"))))
      (should (equal my/org-gcal-calendar-role-alist
                     '(("main@example.com")
                       ("school@example.com" . "school")
                       ("work@example.com" . "work")
                       ("personal@example.com" . "personal")))))))

(ert-deftest my/org-gcal-import-creates-role-and-timed-metadata ()
  (let ((my/org-gcal-calendar-role-alist '(("school-id" . "school"))))
    (with-temp-buffer
      (org-mode)
      (insert "* Class\n")
      (goto-char (point-min))
      (my/org-gcal-annotate-entry
       "school-id"
       '(:start (:dateTime "2026-10-15T09:00:00")
         :transparency "opaque")
       nil)
      (should (equal (org-entry-get nil "CALENDAR_ROLE") "school"))
      (should (equal (org-entry-get nil "GCAL_ALL_DAY") "no")))))

(ert-deftest my/org-gcal-import-updates-and-removes-role ()
  (let ((my/org-gcal-calendar-role-alist
         '(("main-id") ("work-id" . "work"))))
    (with-temp-buffer
      (org-mode)
      (insert "* Meeting\n:PROPERTIES:\n:CALENDAR_ROLE: school\n:END:\n")
      (goto-char (point-min))
      (my/org-gcal-annotate-entry
       "work-id" '(:start (:dateTime "2026-10-15T09:00:00")) nil)
      (should (equal (org-entry-get nil "CALENDAR_ROLE") "work"))
      (my/org-gcal-annotate-entry
       "main-id" '(:start (:dateTime "2026-10-15T09:00:00")) nil)
      (should-not (org-entry-get nil "CALENDAR_ROLE"))
      (org-entry-put nil "CALENDAR_ROLE" "personal")
      (my/org-gcal-annotate-entry
       "unknown-id" '(:start (:dateTime "2026-10-15T09:00:00")) nil)
      (should-not (org-entry-get nil "CALENDAR_ROLE")))))

(ert-deftest my/org-gcal-import-marks-all-day-events-for-zero-allocation ()
