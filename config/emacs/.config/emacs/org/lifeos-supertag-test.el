;;; lifeos-supertag-test.el --- Tests for LifeOS Supertags -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(defvar supertag--initialized)
(load (expand-file-name "lifeos-supertag.el"
                        (file-name-directory
                         (or load-file-name buffer-file-name)))
      nil t)

(defmacro my/lifeos-supertag-test-with-store (initial &rest body)
  "Evaluate BODY with an in-memory canonical tag store seeded by INITIAL."
  (declare (indent 1) (debug t))
  `(let ((by-name (make-hash-table :test #'equal))
         (by-id (make-hash-table :test #'equal))
         (supertag--initialized t)
         (save-count 0)
         (rescan-count 0)
         (stamp-current t)
         (stamp-write-count 0))
     (dolist (entry ,initial)
       (pcase-let ((`(,name . ,id) entry))
         (puthash name id by-name)
         (puthash id (list :id id :name name) by-id)))
     (cl-letf (((symbol-function 'supertag-tag-resolve-occurrence)
                (lambda (name) (gethash name by-name)))
               ((symbol-function 'supertag-tag-get)
                (lambda (id) (gethash id by-id)))
               ((symbol-function 'supertag-tag-create)
                (lambda (props)
                  (let ((id (plist-get props :id))
                        (name (plist-get props :name)))
                    (puthash name id by-name)
                    (puthash id props by-id)
                    props)))
               ((symbol-function 'supertag-save-store)
                (lambda () (cl-incf save-count)))
               ((symbol-function 'supertag-dirty-p) (lambda () nil))
               ((symbol-function 'my/lifeos--supertag-projections-current-p)
                (lambda () stamp-current))
               ((symbol-function 'my/lifeos--write-supertag-projection-stamp)
                (lambda ()
                  (setq stamp-current t)
                  (cl-incf stamp-write-count)))
               ((symbol-function 'supertag-sync-full-rescan)
                (lambda ()
                  (cl-incf rescan-count)
                  '(:status complete :files-processed 1))))
       ,@body)))

(ert-deftest my/lifeos-canonical-tags-verify-without-rescan ()
  (my/lifeos-supertag-test-with-store my/lifeos-canonical-supertags
    (let ((result (my/lifeos-ensure-canonical-supertags)))
      (should-not (plist-get result :created))
      (should-not (plist-get result :rescanned))
      (should (= save-count 0))
      (should (= rescan-count 0))
      (should (= stamp-write-count 0)))))

(ert-deftest my/lifeos-canonical-tags-create-and-rescan-once ()
  (my/lifeos-supertag-test-with-store nil
    (let ((result (my/lifeos-ensure-canonical-supertags)))
      (should (equal (plist-get result :created) '("task" "project" "week")))
      (should (plist-get result :rescanned))
      (should (= save-count 1))
      (should (= rescan-count 1))
      (should (= stamp-write-count 1))
      (dolist (entry my/lifeos-canonical-supertags)
        (should (equal (gethash (car entry) by-name) (cdr entry)))))))

(ert-deftest my/lifeos-canonical-tags-reject-conflicting-identity ()
  (my/lifeos-supertag-test-with-store '(("task" . "wrong-id"))
    (should-error (my/lifeos-ensure-canonical-supertags)
                  :type 'user-error)
      (should (= save-count 0))
      (should (= rescan-count 0))))

(ert-deftest my/lifeos-canonical-tags-retry-unstamped-projections ()
  (my/lifeos-supertag-test-with-store my/lifeos-canonical-supertags
    (setq stamp-current nil)
    (let ((result (my/lifeos-ensure-canonical-supertags)))
      (should-not (plist-get result :created))
      (should (plist-get result :rescanned))
      (should (= rescan-count 1))
      (should (= stamp-write-count 1))
      (should stamp-current))))

(ert-deftest my/lifeos-canonical-tags-support-forced-rescan ()
  (my/lifeos-supertag-test-with-store my/lifeos-canonical-supertags
    (let ((result (my/lifeos-ensure-canonical-supertags t)))
      (should-not (plist-get result :created))
      (should (plist-get result :rescanned))
      (should (= rescan-count 1)))))

(ert-deftest my/lifeos-save-sync-is-added-to-already-open-org-buffers ()
  (require 'org)
  (let ((org-buffer (generate-new-buffer " *lifeos-org-test*"))
        (plain-buffer (generate-new-buffer " *lifeos-plain-test*"))
        configured)
    (unwind-protect
        (progn
          (with-current-buffer org-buffer (org-mode))
          (cl-letf (((symbol-function 'supertag-sync-setup-realtime-hooks)
                     (lambda () (push (current-buffer) configured))))
            (my/lifeos-enable-supertag-save-sync))
          (should (memq org-buffer configured))
          (should-not (memq plain-buffer configured)))
      (kill-buffer org-buffer)
      (kill-buffer plain-buffer))))

(provide 'lifeos-supertag-test)
;;; lifeos-supertag-test.el ends here
