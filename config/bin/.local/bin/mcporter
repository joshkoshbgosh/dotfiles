#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/joshkosh/.local/share/pnpm/global/5/.pnpm/mcporter@0.7.3_hono@4.11.4/node_modules/mcporter/dist/node_modules:/home/joshkosh/.local/share/pnpm/global/5/.pnpm/mcporter@0.7.3_hono@4.11.4/node_modules/mcporter/node_modules:/home/joshkosh/.local/share/pnpm/global/5/.pnpm/mcporter@0.7.3_hono@4.11.4/node_modules:/home/joshkosh/.local/share/pnpm/global/5/.pnpm/node_modules"
else
  export NODE_PATH="/home/joshkosh/.local/share/pnpm/global/5/.pnpm/mcporter@0.7.3_hono@4.11.4/node_modules/mcporter/dist/node_modules:/home/joshkosh/.local/share/pnpm/global/5/.pnpm/mcporter@0.7.3_hono@4.11.4/node_modules/mcporter/node_modules:/home/joshkosh/.local/share/pnpm/global/5/.pnpm/mcporter@0.7.3_hono@4.11.4/node_modules:/home/joshkosh/.local/share/pnpm/global/5/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../share/pnpm/global/5/.pnpm/mcporter@0.7.3_hono@4.11.4/node_modules/mcporter/dist/cli.js" "$@"
else
  exec node  "$basedir/../share/pnpm/global/5/.pnpm/mcporter@0.7.3_hono@4.11.4/node_modules/mcporter/dist/cli.js" "$@"
fi
