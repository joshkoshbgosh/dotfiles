#!/usr/bin/env bash

# Run the git-installed Hermes agent entry point. See ./hermes for why the paths
# are $HOME-relative and why PYTHONPATH/PYTHONHOME are cleared.
unset PYTHONPATH
unset PYTHONHOME

exec "$HOME/.hermes/hermes-agent/venv/bin/python" \
     "$HOME/.hermes/hermes-agent/run_agent.py" "$@"
