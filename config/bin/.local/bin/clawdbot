#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/joshkosh/Work/clawdbot/dist/node_modules:/home/joshkosh/Work/clawdbot/node_modules:/home/joshkosh/Work/node_modules:/home/joshkosh/node_modules:/home/node_modules:/node_modules:/home/joshkosh/.local/share/pnpm/global/5/.pnpm/node_modules"
else
  export NODE_PATH="/home/joshkosh/Work/clawdbot/dist/node_modules:/home/joshkosh/Work/clawdbot/node_modules:/home/joshkosh/Work/node_modules:/home/joshkosh/node_modules:/home/node_modules:/node_modules:/home/joshkosh/.local/share/pnpm/global/5/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../Work/clawdbot/dist/entry.js" "$@"
else
  exec node  "$basedir/../../Work/clawdbot/dist/entry.js" "$@"
fi
