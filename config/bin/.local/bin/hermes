#!/usr/bin/env bash

# Hermes is installed from git into ~/.hermes/hermes-agent, which ships its own
# virtualenv. The omarchy mise/pipx stub expects a pipx install and does not
# match this one.
#
# PYTHONPATH and PYTHONHOME are unset because they belong to whatever shell
# started Hermes, not to its virtualenv.
unset PYTHONPATH
unset PYTHONHOME

exec "$HOME/.hermes/hermes-agent/venv/bin/python" \
     "$HOME/.hermes/hermes-agent/hermes" "$@"
